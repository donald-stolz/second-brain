# This vault is private by default. Every file is ignored except the
# exact paths whitelisted below — no wildcard/pattern rules, so a new
# file is never tracked automatically just by matching a name.

*

!/.gitignore

!/README.md
!/AGENTS.md
!/CLAUDE.md
!/CONTEXT.md

!/00 Inbox/
!/00 Inbox/README.md
!/00 Inbox/CONTEXT.md

!/00 Inbox/Daily Plan/
!/00 Inbox/Daily Plan/CONTEXT.md

!/01 Projects/
!/01 Projects/README.md
!/01 Projects/CONTEXT.md

!/02 Areas/
!/02 Areas/README.md
!/02 Areas/CONTEXT.md

!/03 Resources/
!/03 Resources/README.md
!/03 Resources/CONTEXT.md

!/04 Archive/
!/04 Archive/README.md
!/04 Archive/CONTEXT.md

!/Templates/
!/Templates/README.md
!/Templates/Area Note.md
!/Templates/Inbox Note.md
!/Templates/MOC Note.md
!/Templates/Project Note.md
!/Templates/Resource Note.md
!/Templates/Todo Note.md

!/.agents/
!/.agents/skills/

!/.agents/skills/create-note/
!/.agents/skills/create-note/SKILL.md

!/.agents/skills/link-notes/
!/.agents/skills/link-notes/SKILL.md

!/.agents/skills/weekly-review/
!/.agents/skills/weekly-review/SKILL.md

!/.agents/skills/update-index/
!/.agents/skills/update-index/SKILL.md

!/.agents/skills/inbox-triage/
!/.agents/skills/inbox-triage/SKILL.md

!/.agents/skills/archive-stale/
!/.agents/skills/archive-stale/SKILL.md

!/.agents/skills/daily-review/
!/.agents/skills/daily-review/SKILL.md

# .claude/skills/ mirrors .agents/skills/ via symlinks so Claude Code's
# harness (which only auto-discovers skills under .claude/skills/) can see
# them as slash commands. .agents/skills/ above remains the source of truth.
!/.claude/
!/.claude/skills/
!/.claude/skills/create-note
!/.claude/skills/link-notes
!/.claude/skills/weekly-review
!/.claude/skills/update-index
!/.claude/skills/inbox-triage
!/.claude/skills/archive-stale
!/.claude/skills/daily-review
